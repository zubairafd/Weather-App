# SkyCast Environment Variables Example
# Copy this file to .env for local configuration

VITE_APP_NAME=SkyCast
VITE_DEFAULT_CITY=Peshawar
VITE_DEFAULT_LAT=34.0151
VITE_DEFAULT_LON=71.5249

# Optional: OpenWeatherMap key for extra severe weather alerts & map overlays
# The app works 100% fully without any key using Open-Meteo & RainViewer.
VITE_OWM_API_KEY=your_openweathermap_key_optional
